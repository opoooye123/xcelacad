# ==========================================
# XCEL ACADEMY — SERVER ENVIRONMENT
# ==========================================
# Copy this file to .env and fill in real values.
# Never commit .env itself.

PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/xcelacademy

# Long random string used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-string

# ==========================================
# GOOGLE OAUTH
# ==========================================
# From console.cloud.google.com → APIs & Services →
# Credentials → OAuth 2.0 Client ID (Web application).
# The callback URL below must be listed there as an
# authorised redirect URI.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ==========================================
# FRONTEND
# ==========================================
# Where the API redirects after a successful login,
# and the only origin allowed through CORS.

CLIENT_URL=http://localhost:5173

# Extra allowed origins, comma separated. Useful for a
# staging URL, or your LAN IP when testing on a phone
# (e.g. http://192.168.1.20:5173).
CORS_ORIGINS=

# ==========================================
# ADMIN ACCESS
# ==========================================
# Comma-separated Google addresses. Anyone on this list
# is promoted to admin the next time they sign in, so
# you can add co-admins without a code change.

ADMIN_EMAILS=you@gmail.com
